{
  "Version": "2012-10-17",
  "Id": "wsc2026-db-kms-policy",
  "Statement": [
    {
      "Sid": "AllowKeyManagement",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::003150130236:user/admin"
      },
      "Action": [
        "kms:Create*", "kms:Describe*", "kms:Enable*", "kms:List*",
        "kms:Put*", "kms:Update*", "kms:Revoke*", "kms:Disable*",
        "kms:Get*", "kms:Delete*", "kms:TagResource", "kms:UntagResource",
        "kms:ScheduleKeyDeletion", "kms:CancelKeyDeletion",
        "kms:GenerateDataKey", "kms:Encrypt", "kms:Decrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowAppRoles",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::003150130236:role/wsc2026-book-pod-role",
          "arn:aws:iam::003150130236:role/wsc2026-book-function-role"
        ]
      },
      "Action": [
        "kms:Decrypt", "kms:GenerateDataKey*", "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowDynamoDBService",
      "Effect": "Allow",
      "Principal": {
        "Service": "dynamodb.amazonaws.com"
      },
      "Action": [
        "kms:Encrypt", "kms:Decrypt", "kms:ReEncrypt*",
        "kms:GenerateDataKey*", "kms:DescribeKey", "kms:CreateGrant"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "003150130236",
          "kms:ViaService": "dynamodb.ap-northeast-2.amazonaws.com"
        }
      }
    }
  ]
}
