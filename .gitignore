# Ignore terraform directories
**/.terraform/

# Ignore Terraform state files
*.tfstate
*.tfstate.*

# Ignore Terraform dependency lock files
*.lock.hcl

# Ignore crash log files
crash.log
crash.*.log

# Ignore terraform variables
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore Terraform plan files
*.tfplan
*.tfplan.*
tfplan*
