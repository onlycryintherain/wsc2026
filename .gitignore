# Ignore terraform directories
**/.terraform/

# Ignore Terraform state files
*.tfstate
*.tfstate.*

# Ignore Terraform dependency lock files
*.lock.hcl

# Ignore crash log files
crash.log
crash.*.log

# Ignore terraform variables
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore Terraform plan files
*.tfplan
*.tfplan.*
tfplan*

# Day3 runtime/test outputs belong in temporary storage, not Git.
Day3/tools/profile-sweep-*.json
Day3/tools/test-results*.txt
Day3/*-plan.txt
**/__pycache__/
*.pyc
